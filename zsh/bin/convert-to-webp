#!/usr/bin/env zsh

recursive=false
if [[ "$1" == "-r" ]]; then
  recursive=true
  shift
fi
quality="${1:-80}"
mkdir -p out

if $recursive; then
  find . -not -path "./out/*" -type f | while IFS= read -r file; do
    reldir="$(dirname "$file")"
    dir="out/${reldir#./}"
    mkdir -p "$dir"
    base="$(basename "$file")"
    cp "$file" "$dir/$base"
    case "$base" in
      *.png|*.jpg|*.jpeg)
        output="${base%.*}.webp"
        magick "$dir/$base" -quality "$quality" "$dir/$output" && rm "$dir/$base"
        ;;
    esac
  done
else
  find . -maxdepth 1 -not -path "./out" -not -path "." -type f -exec cp {} out/ \;
  cd out || exit
  for file in *.{png,jpg,jpeg}(N); do
    [[ -e $file ]] || continue
    output="${file%.*}.webp"
    magick "$file" -quality "$quality" "$output" && rm "$file"
  done
  cd ..
fi
