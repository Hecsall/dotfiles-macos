# Tools used by these dotfiles. Install/update everything with:
#   brew bundle --file=Brewfile

# Editor
brew "nano"

# Node.js version manager (replaces nvm)
brew "volta"

# Python version/venv manager
brew "uv"

# Rust toolchain installer (provides ~/.cargo/env, rustup, cargo)
brew "rustup-init"

# Native ZSH plugins, sourced directly (no plugin manager, see zsh/plugins.zsh)
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-history-substring-search"

# Used by keychain-add() in zsh/functions.zsh
brew "keychain"

# Used by media.zsh helpers
brew "jpegoptim"
brew "pngquant"
brew "ghostscript"
brew "imagemagick"

# Docker Desktop replacement
cask "orbstack"
